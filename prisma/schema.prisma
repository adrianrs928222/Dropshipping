generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  email      String
  fullName   String
  phone      String?
  address1   String
  address2   String?
  city       String
  province   String
  postalCode String
  country    String   @default("ES")

  productSku      String
  productName     String
  unitPriceCents  Int
  quantity        Int
  shippingCents   Int
  totalCents      Int

  stripeSessionId String @unique
  paymentIntentId String?
  status          String @default("paid") // paid | processing | shipped | cancelled | refunded
  trackingNumber  String?
  carrier         String?
  notes           String?
}